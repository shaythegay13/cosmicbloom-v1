# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas in production)
MONGODB_URI=mongodb://localhost:27017/farm-and-give

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# RevenueCat (native IAP) — shared secret sent by RevenueCat webhooks in the
# Authorization header; configure the same value in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_AUTH=Bearer change_me_shared_webhook_secret

# Charity Configuration
CHARITY_PERCENTAGE=10

# Frontend URL (web deployment origin, for CORS)
CLIENT_URL=http://localhost:5173

# Client build-time variables (Vite)
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_REVENUECAT_KEY_IOS=appl_xxxxxxxx
# VITE_REVENUECAT_KEY_ANDROID=goog_xxxxxxxx
