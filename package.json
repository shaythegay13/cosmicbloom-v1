{
  "name": "farm-and-give",
  "version": "1.0.0",
  "description": "A farming game where profits support local community gardens",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "vite",
    "client:build": "vite build",
    "client:preview": "vite preview",
    "seed": "node server/scripts/seed.js",
    "scrape-gardens": "node server/scripts/scrapeGardens.js",
    "scrape-gardens-advanced": "node server/scripts/scrapeGardensPuppeteer.js",
    "scrape-all-acga": "node server/scripts/scrapeAllACGAGardens.js",
    "scrape-locatedmap": "node server/scripts/scrapeLocatedMap.js",
    "art": "node tools/art/build.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "game",
    "farming",
    "charity",
    "community"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@revenuecat/purchases-capacitor": "^13.1.5",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "puppeteer": "^21.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@napi-rs/canvas": "^1.0.0",
    "concurrently": "^10.0.3",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
