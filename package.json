{
  "name": "farm-and-give",
  "version": "1.0.0",
  "description": "A farming game where profits support local community gardens",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm start",
    "install-all": "npm install && cd client && npm install",
    "seed": "node server/scripts/seed.js",
    "scrape-gardens": "node server/scripts/scrapeGardens.js",
    "scrape-gardens-advanced": "node server/scripts/scrapeGardensPuppeteer.js",
    "scrape-all-acga": "node server/scripts/scrapeAllACGAGardens.js",
    "scrape-locatedmap": "node server/scripts/scrapeLocatedMap.js"
  },
  "keywords": ["game", "farming", "charity", "community"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^13.5.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "puppeteer": "^21.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
